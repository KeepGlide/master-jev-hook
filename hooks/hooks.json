{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude_jev.py\" hook",
            "timeout": 5,
            "statusMessage": "🔷 Master-JEV Hook: checking the gateway with a live JEV test…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude_jev.py\" prompt",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_master-jev-hook_master-jev-hook__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude_jev.py\" pre",
            "timeout": 3,
            "statusMessage": "🔷 Consulting JEV…"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude_jev.py\" bash-gate",
            "timeout": 20,
            "statusMessage": "🔷 JEV evaluating the command…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_master-jev-hook_master-jev-hook__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude_jev.py\" post",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude_jev.py\" drift",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude_jev.py\" stop-check",
            "timeout": 10,
            "statusMessage": "🔷 JEV verifying completion…"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/claude_jev.py\" precompact",
            "timeout": 12,
            "statusMessage": "🔷 JEV choosing what to preserve…"
          }
        ]
      }
    ]
  }
}
